# Điền các biến này trong Railway > service > Variables.
# Không commit khóa thật. Node không tự đọc .env; khi chạy local có thể dùng:
# node --env-file=.env server.js
RESEND_API_KEY=
LETTER_TO_EMAIL=
# Mặc định dùng onboarding@resend.dev; chỉ gửi đến email đăng ký Resend.
# Nếu có domain đã xác minh, thay bằng địa chỉ thuộc domain đó.
LETTER_FROM_EMAIL=Gui cau <onboarding@resend.dev>
